<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFF8E7"
    app:strokeColor="#E8D5B5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Left: emoji + text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐"
            android:textSize="24sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enjoying DigiPulse?"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1c1554" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to rate us on the Play Store"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Right: Rate button + dismiss -->
        <Button
            android:id="@+id/btnRateApp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Rate ⭐"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#1c1554"
            android:minWidth="72dp"
            app:cornerRadius="12dp" />

        <ImageView
            android:id="@+id/btnDismissRate"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Dismiss"
            app:tint="#999999" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
