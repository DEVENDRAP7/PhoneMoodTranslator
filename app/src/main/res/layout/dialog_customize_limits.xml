<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#F7E7CE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Customize Usage Limits"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <!-- Social Media Limit Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Social Media Limit"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSocialValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1c1554"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarSocial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="23"
            android:progress="3"
            android:progressTint="#1c1554"
            android:thumbTint="#1c1554"
            android:layout_marginBottom="24dp"/>

        <!-- Total Phone Limit Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📵 Total Phone Limit"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6h"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1c1554"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="23"
            android:progress="11"
            android:progressTint="#1c1554"
            android:thumbTint="#1c1554"
            android:layout_marginBottom="24dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveLimits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Limits"
            android:textColor="#000000"
            android:backgroundTint="#FED8B1"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>