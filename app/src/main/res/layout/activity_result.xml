<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:id="@+id/rootLayout">

    <TextView
        android:id="@+id/tvEmoji"
        android:text="🧘"
        android:gravity="center"
        android:textSize="72sp"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Tap for a surprise!"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_gravity="center"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvTitle"
        android:text="Calm and Grounded"
        android:letterSpacing="0.02"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvDescription"
        android:text="Your phone usage stayed balanced today."
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvMoodCriteria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Criteria Explanation..."
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#20FFFFFF"
        android:padding="24dp"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="6dp"
        android:visibility="gone" />
     <com.devendrap7.phonemoodtranslator.views.MoodPetView
        android:id="@+id/moodPet"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvUsageDetails"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChart"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvReflection"
        android:layout_marginTop="20dp"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:textStyle="italic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnDone"
        android:text="Done"
        android:backgroundTint="#d90429"
        android:layout_marginTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>