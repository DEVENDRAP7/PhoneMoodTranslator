<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7E7CE">

    <!-- ── HEADER CARD ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Usage Heatmap"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <!-- Month Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvPrevMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="‹"
                    android:textSize="24sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:background="@drawable/tab_selected_bg"/>

                <TextView
                    android:id="@+id/tvCurrentMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="February 2026"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvNextMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:background="@drawable/tab_selected_bg"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ── SCROLLABLE CONTENT ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEATMAP CARD ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Day labels + Scrollable grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Day Labels Column -->
                        <LinearLayout
                            android:id="@+id/dayLabelsColumn"
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp"/>

                        <!-- Horizontal Scroll -->
                        <HorizontalScrollView
                            android:id="@+id/heatmapScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/heatmapWrapper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <!-- Month Labels -->
                                <LinearLayout
                                    android:id="@+id/monthLabelsRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:orientation="horizontal"/>

                                <!-- Grid -->
                                <LinearLayout
                                    android:id="@+id/heatmapGrid"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"/>

                            </LinearLayout>

                        </HorizontalScrollView>

                    </LinearLayout>

                    <!-- ── LEGEND ── -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Less "
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"/>

                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="#E8E8E8" android:layout_marginEnd="3dp"/>
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="#FFE0B2" android:layout_marginEnd="3dp"/>
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="#FFB74D" android:layout_marginEnd="3dp"/>
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="#FF8C00" android:layout_marginEnd="3dp"/>
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="#E65100" android:layout_marginEnd="3dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" More"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ── EXPANDED WEEK VIEW ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/expandedWeekCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Week Title -->
                    <TextView
                        android:id="@+id/tvWeekTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Week of 3 Feb - 9 Feb"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1c1554"
                        android:layout_marginBottom="4dp"/>

                    <!-- Week Summary Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Total Time -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF3E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱"
                                    android:textSize="18sp"/>

                                <TextView
                                    android:id="@+id/tvWeekTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--h --m"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#1c1554"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total"
                                    android:textSize="11sp"
                                    android:textColor="#AAAAAA"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Most Used App -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF3E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🏆"
                                    android:textSize="18sp"/>

                                <TextView
                                    android:id="@+id/tvWeekTopApp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#1c1554"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:ellipsize="end"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Top App"
                                    android:textSize="11sp"
                                    android:textColor="#AAAAAA"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Mini Bar Chart Container -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Breakdown"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/weekBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginBottom="8dp"/>

                    <!-- Day Labels under bars -->
                    <LinearLayout
                        android:id="@+id/weekBarLabels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ── STATS CARD ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Time Stats"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1c1554"
                        android:layout_marginBottom="16dp"/>

                    <!-- Stat Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF3E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📅"
                                    android:textSize="20sp"/>

                                <TextView
                                    android:id="@+id/tvTotalDays"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- days"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#1c1554"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tracked"
                                    android:textSize="11sp"
                                    android:textColor="#AAAAAA"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF3E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📊"
                                    android:textSize="20sp"/>

                                <TextView
                                    android:id="@+id/tvAvgDaily"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--h --m"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#1c1554"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Daily Avg"
                                    android:textSize="11sp"
                                    android:textColor="#AAAAAA"/>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Peak Day -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF3E0">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔥"
                                android:textSize="24sp"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Peak Day"
                                    android:textSize="11sp"
                                    android:textColor="#AAAAAA"/>

                                <TextView
                                    android:id="@+id/tvPeakDay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- --- ----"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#1c1554"/>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>