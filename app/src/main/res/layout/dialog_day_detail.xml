<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── MAIN CARD ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#FED8B1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ── HEADER ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="#FED8B1">

                    <TextView
                        android:id="@+id/tvDayDetailTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monday, 12 Feb"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <!-- Total Time Big Display -->
                    <TextView
                        android:id="@+id/tvDayDetailTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 0m"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Screen Time"
                        android:textSize="13sp"
                        android:textColor="#B3000000"/>

                </LinearLayout>

                <!-- ── HOURLY BLOCKS ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hourly Breakdown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1c1554"
                        android:layout_marginBottom="12dp"/>

                    <GridLayout
                        android:id="@+id/hourlyGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="6"
                        android:rowCount="2"
                        android:useDefaultMargins="false"/>

                    <!-- Hour labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="12AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="2AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="4AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="6AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="8AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="10AM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="12PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="2PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="4PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="6PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="8PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>
                        <TextView android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="10PM"
                            android:textSize="10sp" android:textColor="#AAAAAA"
                            android:gravity="center"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#F0F0F0"/>

                <!-- ── TOP APPS LIST ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Apps"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1c1554"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/llDayAppList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

                <!-- ── CLOSE BUTTON ── -->
                <Button
                    android:id="@+id/btnCloseDayDetail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:text="Close"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:backgroundTint="#F7E7CE"
                    app:cornerRadius="16dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>