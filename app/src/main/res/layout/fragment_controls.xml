<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Future Self Intervention"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#4A148C"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write a message to yourself. If you cross your usage limit tomorrow, we will show you this note."
        android:textColor="#666666"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Your Message (e.g. 'Read a book!')">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFutureNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSaveNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Note"
        android:layout_marginTop="12dp"
        android:backgroundTint="#4A148C"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Strict Mode Limits"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchSocialLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limit Social Media (2 hrs)"
        android:textSize="16sp"
        android:checked="true"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchTotalLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limit Total Phone Use (6 hrs)"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:checked="true"/>

</LinearLayout>